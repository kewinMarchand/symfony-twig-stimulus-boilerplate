{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3230/",
        "http://127.0.0.1:3230/catalogue",
        "http://127.0.0.1:3230/catalogue/plantes-interieur/feuillages",
        "http://127.0.0.1:3230/taches",
        "http://127.0.0.1:3230/contact",
        "http://127.0.0.1:3230/mentions-legales",
        "http://127.0.0.1:3230/donnees-personnelles",
        "http://127.0.0.1:3230/accessibilite",
        "http://127.0.0.1:3230/plan-du-site"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
