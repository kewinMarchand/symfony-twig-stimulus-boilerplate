# Valeurs par défaut, versionnées. Aucun secret réel ici : surcharger dans .env.local
# (non versionné) ou par de vraies variables d'environnement, qui gagnent toujours.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

# URL publique du site : URL canoniques, Open Graph, sitemap, et URL générées hors requête
SITE_URL=http://localhost:8095
