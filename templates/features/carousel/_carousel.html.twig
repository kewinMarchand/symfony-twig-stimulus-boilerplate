{#- Carrousel agnostique : id, title, testid, slides = [{image (préfixe dans assets/images), title, text}] -#}
<section class="carousel" aria-roledescription="carrousel" aria-labelledby="{{ id }}-title" data-testid="{{ testid }}" data-controller="carousel">
    <div class="carousel__header">
        <h2 id="{{ id }}-title">{{ title }}</h2>
        <div class="carousel__controls">
            <button type="button" class="button button--outlined" aria-controls="{{ id }}-track" data-carousel-target="previous" data-action="carousel#previous" data-testid="carousel-prev" disabled>
                {{ include('core/ui/_icon.html.twig', {name: 'chevron-left'}) }}
                <span>Précédent</span>
            </button>
            <button type="button" class="button button--outlined" aria-controls="{{ id }}-track" data-carousel-target="next" data-action="carousel#next" data-testid="carousel-next">
                <span>Suivant</span>
                {{ include('core/ui/_icon.html.twig', {name: 'chevron-right'}) }}
            </button>
        </div>
    </div>
    <div id="{{ id }}-track" class="carousel__viewport" role="group" aria-label="Diapositives" tabindex="0" data-carousel-target="viewport" data-testid="carousel-track">
        <div class="carousel__container">
            {% for slide in slides %}
                <div class="carousel__slide" role="group" aria-roledescription="diapositive" aria-label="{{ loop.index }} sur {{ slides|length }}" data-testid="carousel-slide">
                    {{ include('core/ui/_picture.html.twig', {name: slide.image, widths: [640, 1280], sizes: '(min-width: 1024px) calc((min(100vw, 1440px) - 96px) / 3), (min-width: 768px) calc((100vw - 64px) / 2), calc(100vw - 32px)', class: 'carousel__image'}) }}
                    <h3 class="carousel__title">{{ slide.title }}</h3>
                    <p>{{ slide.text }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
    <div class="carousel__dots" data-carousel-target="dots"></div>
</section>
