{% extends 'base.html.twig' %}

{% set server_rendered = tasks is defined %}
{% set seo = seo_page({
    title: 'Tâches',
    description: 'Démo Turbo Frame : liste de tâches chargée à la demande, avec gestion du chargement, des erreurs et de la liste vide.',
    canonical: path('tasks'),
    robots: server_rendered ? 'noindex, follow' : 'index, follow',
}) %}

{% block body %}
    <h1>Tâches</h1>
    <p class="lead">Liste chargée à la demande dans un Turbo Frame : chargement, erreur avec relance et liste vide sont gérés.</p>
    {% if server_rendered %}
        {{ include('tasks/_list.html.twig') }}
    {% else %}
        <turbo-frame id="tasks" src="{{ path('tasks_list') }}" loading="lazy" aria-live="polite">
            <div class="skeleton-list tasks__loading" role="status" aria-busy="true" aria-label="Chargement des tâches" data-testid="tasks-loading">
                <span class="skeleton"></span>
                <span class="skeleton"></span>
                <span class="skeleton"></span>
            </div>
            <noscript>
                <p><a href="{{ path('tasks_list') }}" data-testid="tasks-noscript-link">Afficher les tâches</a></p>
            </noscript>
        </turbo-frame>
    {% endif %}
{% endblock %}
