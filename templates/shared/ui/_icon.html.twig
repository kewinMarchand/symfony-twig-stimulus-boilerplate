{#- Seul point d'utilisation du sprite public/icons.svg : name = nom de icons.json, icon_label optionnel pour une icône porteuse de sens -#}
{%- if icon_label|default(false) -%}
    <svg width="1em" height="1em" role="img" aria-label="{{ icon_label }}"><use href="/icons.svg#{{ name }}"></use></svg>
{%- else -%}
    <svg width="1em" height="1em" aria-hidden="true" focusable="false"><use href="/icons.svg#{{ name }}"></use></svg>
{%- endif -%}
