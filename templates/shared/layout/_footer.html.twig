<footer class="footer" data-testid="layout-footer">
    <div class="footer__inner container">
        <nav aria-label="Liens légaux">
            <ul class="footer__links" role="list">
                {% for item in site.navigation.legal %}
                    <li>
                        <a href="{{ path(item.route) }}"{% if app.current_route == item.route %} aria-current="page"{% endif %}>{{ item.label }}{% if item.route == 'legal_accessibility' %} : {{ accessibility_compliance().value }}{% endif %}</a>
                    </li>
                {% endfor %}
                {% if app.environment == 'dev' %}
                    <li><a href="{{ path('styleguide') }}">Charte graphique (dev)</a></li>
                {% endif %}
            </ul>
        </nav>
        <p class="footer__brand">
            <img src="{{ asset('images/logo-mark.svg') }}" alt="" width="20" height="20">
            <span>{{ site.name }}</span>
        </p>
    </div>
</footer>
