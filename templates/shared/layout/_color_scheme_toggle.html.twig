{#- Bascule du thème (spec commune, section 20) : menu à choix cochés de boilerplates-ui. Servie sur « système », le contrôleur color-scheme la remet sur le choix mémorisé. -#}
<div class="bui-menu color-scheme-toggle" data-bui-menu data-controller="color-scheme" data-action="bui-menu-select->color-scheme#select">
    <button type="button" class="bui-button bui-button--nav bui-button--icon bui-menu__trigger" id="color-scheme-trigger" aria-label="Thème : système" aria-haspopup="menu" aria-expanded="false" aria-controls="color-scheme-list" data-testid="color-scheme-toggle" data-color-scheme-target="trigger">
        {{- include('shared/ui/_icon.html.twig', {name: 'monitor'}) -}}
    </button>
    <ul class="bui-menu__list" role="menu" id="color-scheme-list" aria-labelledby="color-scheme-trigger" hidden>
        {% for scheme, label in {auto: 'Système', light: 'Clair', dark: 'Sombre'} %}
            <li role="none">
                <button type="button" class="bui-menu__item" role="menuitemradio" aria-checked="{{ scheme == 'auto' ? 'true' : 'false' }}" tabindex="-1" data-bui-menu-item="{{ scheme }}" data-testid="color-scheme-option-{{ scheme }}" data-color-scheme-target="item">
                    {{- include('shared/ui/_icon.html.twig', {name: 'check', class: 'bui-menu__check'}) -}}
                    {{- label -}}
                </button>
            </li>
        {% endfor %}
    </ul>
</div>
