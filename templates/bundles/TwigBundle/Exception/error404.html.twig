{% extends 'base.html.twig' %}

{% set seo = seo_page({title: 'Page introuvable', description: 'La page demandée n’existe pas ou a été déplacée. Retrouvez votre chemin depuis l’accueil, le plan du site ou le catalogue.', robots: 'noindex', canonical: false, breadcrumb: [{label: 'Page introuvable'}]}) %}

{% block body %}
    <h1>Page introuvable</h1>
    <p class="lead">La page demandée n’existe pas ou a été déplacée.</p>
    <ul class="error-links" role="list">
        <li><a class="button" href="{{ path('home') }}" data-testid="error-home-link">Retour à l’accueil</a></li>
        <li><a class="button button--outlined" href="{{ path('legal_sitemap') }}">Plan du site</a></li>
        <li><a class="button button--outlined" href="{{ path('catalog') }}">Catalogue</a></li>
    </ul>
{% endblock %}
