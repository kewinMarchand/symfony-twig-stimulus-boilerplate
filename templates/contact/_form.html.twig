{%- set first_invalid = form|filter(child => not child.vars.valid)|map(child => child.vars.name)|first -%}
{{ form_start(form, {attr: {id: 'contact-form', class: 'form'}}) }}
    {{ form_errors(form) }}
    {{ form_row(form.name, {row_attr: {class: 'field'}, attr: {autocomplete: 'name', autofocus: first_invalid == 'name', 'data-testid': 'contact-name'}}) }}
    {{ form_row(form.email, {row_attr: {class: 'field'}, attr: {autocomplete: 'email', autofocus: first_invalid == 'email', 'data-testid': 'contact-email'}}) }}
    {{ form_row(form.message, {row_attr: {class: 'field'}, attr: {rows: 5, autofocus: first_invalid == 'message', 'data-testid': 'contact-message'}}) }}
    <button type="submit" class="button" data-testid="contact-submit">
        {{ include('core/ui/_icon.html.twig', {name: 'mail'}) }}
        <span>Envoyer</span>
    </button>
{{ form_end(form) }}
